<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="LateApexEarlySpeed.Json.Schema" Version="4.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="MsgReader" Version="6.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- PDF of the catalog (step 96). Pinned to 6.2.4, the last MIT version:
         from 6.5.0 (14-10-2026) PDFsharp and MigraDoc are AGPL-3.0. Do not update. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="[6.2.4]" />
    <!-- The official Gherkin parser (cucumber/gherkin, MIT): checks the .feature files of the backlog (step 97). -->
    <PackageReference Include="Gherkin" Version="42.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- IBM Plex Sans (SIL Open Font License 1.1, Fonts/OFL.txt), the font of the web, embedded in the PDFs. -->
    <EmbeddedResource Include="Deliverables\Export\Fonts\*.ttf" LogicalName="fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The current requirements prompt, its repair annex and the catalog schema,
         embedded in the DLL from prompts/ (the versioned source), so the API never
         depends on files next to it. LogicalName is the resource name used in code. -->
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\prompt_requisitos_v1.4.md" LogicalName="prompt_requisitos.md" />
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\anexo_reparacion_v1.4.md" LogicalName="anexo_reparacion.md" />
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\requirements_v1.3.schema.json" LogicalName="requirements.schema.json" />
    <!-- Catalog v2 (validators only, until the platform runs it). -->
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\inventory_v2.schema.json" LogicalName="inventory.schema.json" />
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\requirements_v2.schema.json" LogicalName="requirements_v2.schema.json" />
    <!-- Iteration v0 (step 42): the prompts, the repair annex and the schemas of every phase.
         LogicalName keeps the folder: "v0/catalogo.md", "v0/esquemas/catalogo.schema.json". -->
    <EmbeddedResource Include="..\..\prompts\v0\*.md" Exclude="..\..\prompts\v0\README.md;..\..\prompts\v0\CHANGELOG.md" LogicalName="v0/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\prompts\v0\esquemas\*.schema.json" LogicalName="v0/esquemas/%(Filename)%(Extension)" />
    <!-- The ReservaSalas example: FakeProvider answers it with its catalog. -->
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\ejemplo\fragmentos.json" LogicalName="ejemplo_fragmentos.json" />
    <EmbeddedResource Include="..\..\prompts\generacion_requisitos\ejemplo\catalogo_ejemplo_v1.3.json" LogicalName="ejemplo_catalogo.json" />
  </ItemGroup>

</Project>
