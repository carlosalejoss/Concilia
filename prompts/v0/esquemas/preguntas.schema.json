{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tfg/v0/preguntas.schema.json",
  "title": "Preguntas v0 (salida de Modelo A / Modelo B)",
  "$comment": "Solo la estructura. Las reglas entre campos (ids únicos y consecutivos, referencias, `de` con algún id…) las comprueba la plataforma: ver validar_v0.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preguntas"
  ],
  "properties": {
    "preguntas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pregunta"
      }
    }
  },
  "$defs": {
    "pregunta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pregunta",
        "motivo",
        "fuentes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P-[0-9]{3,}$"
        },
        "pregunta": {
          "type": "string",
          "minLength": 1
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DOC-[0-9]{2,}#F[0-9]{3,}$"
          },
          "minItems": 1
        }
      }
    }
  }
}
