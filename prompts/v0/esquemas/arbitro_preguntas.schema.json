{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tfg/v0/arbitro_preguntas.schema.json",
  "title": "Preguntas v0 unidas por el árbitro",
  "$comment": "Solo la estructura. Las reglas entre campos (ids únicos y consecutivos, referencias, `de` con algún id…) las comprueba la plataforma: ver validar_v0.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preguntas",
    "descartadas"
  ],
  "properties": {
    "preguntas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pregunta"
      }
    },
    "descartadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "propuesta",
          "id",
          "motivo"
        ],
        "properties": {
          "propuesta": {
            "enum": [
              1,
              2
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^P-[0-9]{3,}$"
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "pregunta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pregunta",
        "motivo",
        "fuentes",
        "de",
        "explicacion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P-[0-9]{3,}$"
        },
        "pregunta": {
          "type": "string",
          "minLength": 1
        },
        "motivo": {
          "type": "string",
          "minLength": 1
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DOC-[0-9]{2,}#F[0-9]{3,}$"
          },
          "minItems": 1
        },
        "de": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "propuesta_1",
            "propuesta_2"
          ],
          "properties": {
            "propuesta_1": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^P-[0-9]{3,}$"
              }
            },
            "propuesta_2": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^P-[0-9]{3,}$"
              }
            }
          }
        },
        "explicacion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
