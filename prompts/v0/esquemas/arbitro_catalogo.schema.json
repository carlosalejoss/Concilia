{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tfg/v0/arbitro_catalogo.schema.json",
  "title": "Catálogo de requisitos v0 unido por el árbitro",
  "$comment": "Solo la estructura. Las reglas entre campos (ids únicos y consecutivos, referencias, `de` con algún id…) las comprueba la plataforma: ver validar_v0.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requisitos",
    "descartados"
  ],
  "properties": {
    "requisitos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requisito"
      }
    },
    "descartados": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "propuesta",
          "id",
          "motivo"
        ],
        "properties": {
          "propuesta": {
            "enum": [
              1,
              2
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^(RF|RNF|RA|RT|RI)-[0-9]{3,}$"
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "requisito": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "notacion",
        "obligatoriedad",
        "texto",
        "fuentes",
        "preguntas",
        "de",
        "discrepancia",
        "explicacion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(RF|RNF|RA|RT|RI)-[0-9]{3,}$"
        },
        "tipo": {
          "enum": [
            "RF",
            "RNF",
            "RA",
            "RT",
            "RI"
          ]
        },
        "notacion": {
          "enum": [
            "EARS",
            "MASTeR"
          ]
        },
        "obligatoriedad": {
          "enum": [
            "shall",
            "should",
            "may"
          ]
        },
        "texto": {
          "type": "string",
          "minLength": 1
        },
        "fuentes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DOC-[0-9]{2,}#F[0-9]{3,}$"
          }
        },
        "preguntas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P-[0-9]{3,}$"
          }
        },
        "de": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "propuesta_1",
            "propuesta_2"
          ],
          "properties": {
            "propuesta_1": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(RF|RNF|RA|RT|RI)-[0-9]{3,}$"
              }
            },
            "propuesta_2": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(RF|RNF|RA|RT|RI)-[0-9]{3,}$"
              }
            }
          }
        },
        "discrepancia": {
          "type": "boolean"
        },
        "explicacion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
