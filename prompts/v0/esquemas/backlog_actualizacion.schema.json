{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tfg/v0/backlog_actualizacion.schema.json",
  "title": "Actualización del backlog con unas iteraciones v0.13 (salida de Modelo A / Modelo B)",
  "$comment": "Solo la estructura. Las reglas entre campos (ids nuevos consecutivos, que las modificadas y eliminadas existan en el backlog validado y no se repitan, que los criterios y tareas citados sean de esa historia, que los requisitos existan en el catálogo validado, que la épica exista…) las comprueba la plataforma.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nuevas",
    "modificadas",
    "eliminadas"
  ],
  "properties": {
    "nuevas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "epica",
          "titulo",
          "como",
          "quiero",
          "para",
          "requisitos",
          "criterios",
          "tareas",
          "motivo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^N-[0-9]{3,}$"
          },
          "epica": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^EP-[0-9]{2,}$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "titulo",
                  "descripcion"
                ],
                "properties": {
                  "titulo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "descripcion": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "como": {
            "type": "string",
            "minLength": 1
          },
          "quiero": {
            "type": "string",
            "minLength": 1
          },
          "para": {
            "type": "string",
            "minLength": 1
          },
          "requisitos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(RF|RNF|RA|RT|RI)-[0-9]{3,}$"
            }
          },
          "criterios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "escenario",
                "dado",
                "cuando",
                "entonces"
              ],
              "properties": {
                "escenario": {
                  "type": "string",
                  "minLength": 1
                },
                "dado": {
                  "type": "string",
                  "minLength": 1
                },
                "cuando": {
                  "type": "string",
                  "minLength": 1
                },
                "entonces": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "tareas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "titulo"
              ],
              "properties": {
                "titulo": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "modificadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titulo",
          "como",
          "quiero",
          "para",
          "requisitos",
          "criterios",
          "tareas",
          "motivo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HU-[0-9]{3,}$"
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "como": {
            "type": "string",
            "minLength": 1
          },
          "quiero": {
            "type": "string",
            "minLength": 1
          },
          "para": {
            "type": "string",
            "minLength": 1
          },
          "requisitos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(RF|RNF|RA|RT|RI)-[0-9]{3,}$"
            }
          },
          "criterios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^CA-[0-9]{3,}$"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "escenario",
                    "dado",
                    "cuando",
                    "entonces"
                  ],
                  "properties": {
                    "escenario": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dado": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cuando": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entonces": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "tareas": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^T-[0-9]{3,}$"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "titulo"
                  ],
                  "properties": {
                    "titulo": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "eliminadas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "motivo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HU-[0-9]{3,}$"
          },
          "motivo": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
