# Copy this file to .env and fill in the values. Never commit .env.

# LiteLLM gateway (used from milestone 3 on, by the runner).
# The base URL may end with or without "/v1".
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Runner provider: Fake (default when empty, no model is called) or LiteLlm.
RUNNER_PROVIDER=
# Models A and B of every job, exactly as the gateway names them
# (defaults when empty: A = SS - GPT-6-SOL, B = SS - GPT-6-LUNA).
RUNNER_MODEL_A=
RUNNER_MODEL_B=
# Fake only: true makes the first catalog of each lot invalid, to see the
# repair retry working (default when empty: false).
RUNNER_SIMULATE_REPAIR=
# Output tokens per model response (default when empty: 64000). Claude Code
# assumes 32000 otherwise, and the model's reasoning counts towards it.
RUNNER_MAX_OUTPUT_TOKENS=

# Password for the PostgreSQL user "reqarbiter" (any value for local use).
POSTGRES_PASSWORD=
