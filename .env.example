# Copy this file to .env and fill in the values. Never commit .env.

# LiteLLM gateway (used from milestone 3 on, by the runner).
# The base URL may end with or without "/v1".
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Runner provider: Fake (default when empty, no model is called) or LiteLlm.
RUNNER_PROVIDER=
# Models A and B of every job, exactly as the gateway names them
# (defaults when empty: A = SS - GPT-6-SOL, B = SS - GPT-6-LUNA).
RUNNER_MODEL_A=
RUNNER_MODEL_B=
# Arbiter of the v0 phases (questions, catalog and backlog), which joins the
# outputs of A and B (default when empty: SS - GPT-6-SOL).
RUNNER_MODEL_ARBITER=
# Model that suggests answers to the pending questions of a round
# (default when empty: SS - GPT-6-SOL).
RUNNER_MODEL_SUGGESTIONS=
# Fake only: true makes the first catalog of each lot invalid, to see the
# repair retry working (default when empty: false).
RUNNER_SIMULATE_REPAIR=
# Output tokens per model response (default when empty: 64000). Claude Code
# assumes 32000 otherwise, and the model's reasoning counts towards it.
RUNNER_MAX_OUTPUT_TOKENS=

# Mockup provider: Fake (default when empty), ClaudeSubscription or LiteLlm.
MOCKUP_PROVIDER=
# Mockup model (default when empty: claude-sonnet-5-5).
MOCKUP_MODEL=
# Token of the author's Claude subscription, from "claude setup-token" (valid
# one year). Only for the author's own use: it only reaches the mockup run.
CLAUDE_CODE_OAUTH_TOKEN=

# Password for the PostgreSQL user "reqarbiter" (any value for local use).
POSTGRES_PASSWORD=
